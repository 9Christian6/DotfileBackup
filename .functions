function open(){nohup xdg-open "$@" >/dev/null 2>&1&}

function unzip() {
  if [[ $# -eq 1 && "$1" == *.zip ]]; then
    local zipfile="$1"
      local dirname="${zipfile%.zip}"

      mkdir -p "$dirname"
      command unzip "$zipfile" -d "$dirname"
  else
    command unzip "$@"
      fi
}

function fcd() {
  local target
    target=$(find . -mindepth 1 \( -type d -o -type f \) | fzf) || return

    if [ -d "$target" ]; then
      cd "$target"
    else
      cd "$(dirname "$target")"
	fi
}

function findPattern(){
  grep -rnw "$(pwd)" -e "$1"
}

function findFile(){
  find ./ -iname "*$1*"
}

function odysseus() {
    # Define the absolute path to your project root once.
    PROJECT_PATH="/home/christian/Opt/odysseus"

    # 1. Save the current directory so we can return to it.
    local original_pwd=$(pwd)

    # 2. Change to the project directory.
    if [ -d "$PROJECT_PATH" ]; then
        cd "$PROJECT_PATH"
        echo "--- Running Odysseus from $PROJECT_PATH ---"

        # Execute the command
        /home/christian/Opt/odysseus/venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 7000

        # Optional: Change back to the directory we started in
        cd "$original_pwd"
    else
        echo "ERROR: Project directory not found at $PROJECT_PATH"
    fi
}
