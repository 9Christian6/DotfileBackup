#filetype=bash

anifetch() {
    command anifetch "$@"
    
    # Fix the stuck cursor/screen
    tput cnorm       
    printf "\e[?1049l" 
    
    # Hide the ugly ^[[Hw^[[F% text glitch
    tput el 
    printf "\e[1A" # Move up one line to overwrite the glitch
}

function testAlias(){echo "alias $1='$2'"; }

function addAlias(){echo "alias $1='$2'" >> ~/.zshrc; }

function search(){ls -lt -c -r -h -a|awk '{print $9}' | grep -i $1}

function showInstalled(){dpkg --list "*$1*"}

function makecd(){mkdir $1 && cd $1}

function compileDebug(){
  g++ -Wall -Wextra -fsanitize=undefined,address -D_GLIBCXX_DEBUG -g "$1" -o "${1%.*}"
}

function compile(){
  if [ $# -eq 2 ]
    then
      g++ -x c++ -Wall -O2 -static -pipe "$1" -o "$2"
    else
      g++ -x c++ -Wall -O2 -static -pipe "$1"
  fi
}

