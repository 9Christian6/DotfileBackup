# Default config for sway

gaps inner 5
default_border pixel 2
default_floating_border none

# client.focused         		#880088 #880088 #880088 #008800 #880088 
# client.focused_inactive         #880088 #880088 #880088 #008800 #880088
# client.unfocused        	#008800 #008800 #008800 #008800 #008800 

# Define colors
# set $green   #008800
# set $magenta #880088
# set $split   #00F000
# set $white   #FFFFFF

# Borders
# Format: client.<state> <border> <background> <text> <indicator> <child_border>
# client.focused          $magenta $magenta $white $magenta $magenta
# client.focused_inactive $green   $green   $magenta   $green $green
# client.unfocused        $green   $split   $magenta   $green $green
# client.urgent           $green   $green   $magenta   $green $green
# client.placeholder      $green   $green   $magenta   $green $green

# Define colors
set $green   #008800
set $magenta #880088
set $split   #00F000
set $white   #FFFFFF

# Define complementary text colors
set $text_on_green   #FF77FF
set $text_on_magenta #77FF77
set $text_on_split   #FF0FFF
set $text_on_white   #000000

# Borders
# Format: client.<state> <border> <background> <text> <indicator> <child_border>

client.focused          $magenta $magenta $text_on_white $magenta $magenta
client.focused_inactive $green   $green   $text_on_white   $green   $green
client.unfocused        $green   $split   $text_on_white   $green   $green
client.urgent           $green   $green   $text_on_white   $green   $green
client.placeholder      $green   $green   $text_on_white   $green   $green

font pango:monospace 9
titlebar_border_thickness 2
hide_edge_borders none
