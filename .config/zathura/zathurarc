set selection-clipboard clipboard
map h navigate previous
map l navigate next
map <C-h> scroll half-up
map <C-l> scroll half-down

# Jump to first/last page
map gg goto top
map G goto bottom

# Vim-like scrolling
map <C-e> scroll down
map <C-y> scroll up

# Vim-like full-page movement
map <C-f> scroll full-down
map <C-b> scroll full-up
