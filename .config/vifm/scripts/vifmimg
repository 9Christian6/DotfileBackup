#!/bin/sh

ICAT_PID_FILE="/tmp/vifm-icat-preview.pid"
WORKER_PID_FILE="/tmp/vifm-icat-preview-worker.pid"
REQUEST_FILE="/tmp/vifm-icat-preview.request"
KITTY_KITTEN="${HOME}/Opt/kitty/bin/kitten"
MAX_PREVIEW_BYTES=$((1024 * 1024))

if [ ! -x "$KITTY_KITTEN" ]; then
  KITTY_KITTEN="$(command -v kitten 2>/dev/null)"
fi

resolve_path() {
  readlink -f -- "$1"
}

preview_path() {
  case "$1" in
    /*) resolve_path "$1" ;;
    *) resolve_path "$PWD/$1" ;;
  esac
}

cache_base() {
  stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$1" |
    sha256sum | awk '{print $1}'
}

file_size_bytes() {
  stat --printf '%s' -- "$1" 2>/dev/null
}

media_orientation() {
  ffprobe -v error \
    -select_streams v:0 \
    -show_entries stream=width,height \
    -of csv=p=0:s=' ' \
    -- "$1" 2>/dev/null | awk '
      NF >= 2 {
        if ($1 >= $2) {
          print "landscape"
        } else {
          print "portrait"
        }
        exit
      }
    '
}

current_request() {
  cat "$REQUEST_FILE" 2>/dev/null
}

set_request() {
  printf '%s\n' "$1" > "$REQUEST_FILE"
}

pid_is_alive() {
  pid_file="$1"
  if [ ! -f "$pid_file" ]; then
    return 1
  fi

  pid="$(cat "$pid_file" 2>/dev/null)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

request_is_active() {
  request_id="$1"
  [ "$(current_request)" = "$request_id" ] || return 1
  pid_is_alive "$WORKER_PID_FILE" || pid_is_alive "$ICAT_PID_FILE"
}

init_preview_context() {
  preview_file="$(preview_path "$1")"
  PCACHE="$HOME/.cache/vifm/thumbnail.$(
    cache_base "$preview_file"
  )"
}

preview_allowed() {
  size_bytes="$(file_size_bytes "$preview_file")"
  [ -n "$size_bytes" ] || return 1
  [ "$size_bytes" -le "$MAX_PREVIEW_BYTES" ]
}

pclear() {
  clear_display

  if [ -f "$WORKER_PID_FILE" ]; then
    worker_pid="$(cat "$WORKER_PID_FILE" 2>/dev/null)"
    if [ -n "$worker_pid" ] && kill -0 "$worker_pid" 2>/dev/null; then
      kill "$worker_pid" 2>/dev/null
      sleep 0.05
      kill -9 "$worker_pid" 2>/dev/null
    fi
  fi

  rm -f "$WORKER_PID_FILE" "$REQUEST_FILE"
}

clear_display() {
  if [ -n "$FIFO_UEBERZUG" ] && [ -p "$FIFO_UEBERZUG" ]; then
    printf '{"action": "remove", "identifier": "vifm-preview"}\n' > "$FIFO_UEBERZUG"
  fi

  if [ -f "$ICAT_PID_FILE" ]; then
    icat_pid="$(cat "$ICAT_PID_FILE" 2>/dev/null)"
    if [ -n "$icat_pid" ] && kill -0 "$icat_pid" 2>/dev/null; then
      kill "$icat_pid" 2>/dev/null
      sleep 0.05
      kill -9 "$icat_pid" 2>/dev/null
    fi
  fi

  tty_path="$(find_tty)"
  if [ -n "$tty_path" ] && [ -c "$tty_path" ] && [ -x "$KITTY_KITTEN" ]; then
    "$KITTY_KITTEN" icat --stdin=no --clear --silent >"$tty_path" <"$tty_path" 2>/dev/null
  fi

  rm -f "$ICAT_PID_FILE"
}

clear_display_on_tty() {
  tty_path="$1"

  if [ -n "$FIFO_UEBERZUG" ] && [ -p "$FIFO_UEBERZUG" ]; then
    printf '{"action": "remove", "identifier": "vifm-preview"}\n' > "$FIFO_UEBERZUG"
  fi

  if [ -f "$ICAT_PID_FILE" ]; then
    icat_pid="$(cat "$ICAT_PID_FILE" 2>/dev/null)"
    if [ -n "$icat_pid" ] && kill -0 "$icat_pid" 2>/dev/null; then
      kill "$icat_pid" 2>/dev/null
      sleep 0.05
      kill -9 "$icat_pid" 2>/dev/null
    fi
  fi

  if [ -n "$tty_path" ] && [ -c "$tty_path" ] && [ -x "$KITTY_KITTEN" ]; then
    "$KITTY_KITTEN" icat --stdin=no --clear --silent >"$tty_path" <"$tty_path" 2>/dev/null
  fi

  rm -f "$ICAT_PID_FILE"
}

image() {
  printf '{"action": "add", "identifier": "vifm-preview", "x": "%s", "y": "%s", "width": "%s", "height": "%s", "scaler": "contain", "path": "%s"}\n' \
    "$2" "$3" "$4" "$5" "$6" > "$FIFO_UEBERZUG"
}

find_tty() {
  for fd in 1 2 0; do
    path="$(readlink -f "/proc/$$/fd/$fd" 2>/dev/null)"
    case "$path" in
      /dev/pts/*|/dev/tty*) printf '%s\n' "$path"; return 0 ;;
    esac
  done

  pid="$$"
  while [ "$pid" -gt 1 ] 2>/dev/null; do
    for fd in 1 2 0; do
      path="$(readlink -f "/proc/$pid/fd/$fd" 2>/dev/null)"
      case "$path" in
        /dev/pts/*|/dev/tty*) printf '%s\n' "$path"; return 0 ;;
      esac
    done
    pid="$(awk '/^PPid:/ { print $2 }' "/proc/$pid/status" 2>/dev/null)"
    [ -n "$pid" ] || break
  done

  return 1
}

video_preview_file() {
  pane_w="$1"
  pane_h="$2"

  case "$preview_file" in
    *.gif|*.GIF|*.webp|*.WEBP)
      printf '%s\n' "$preview_file"
      ;;
    *)
      orient="$(media_orientation "$preview_file")"
      [ -n "$orient" ] || orient="landscape"
      anim_cache="${PCACHE}.${pane_w}x${pane_h}.${orient}.2s.gif"
      printf '%s\n' "$anim_cache"
      ;;
  esac
}

video_still_file() {
  still_cache="${PCACHE}.first-frame.jpg"
  if [ ! -f "$still_cache" ]; then
    if command -v ffmpegthumbnailer >/dev/null 2>&1; then
      ffmpegthumbnailer -i "$preview_file" -o "$still_cache" -s 0 -q 5 >/dev/null 2>&1 || return 1
    else
      ffmpeg -hide_banner -loglevel error \
        -ss 0 -i "$preview_file" \
        -frames:v 1 \
        -q:v 2 \
        "$still_cache" || return 1
    fi
  fi
  printf '%s\n' "$still_cache"
}

render_video_anim() {
  pane_w="$1"
  pane_h="$2"
  anim_cache="$(video_preview_file "$pane_w" "$pane_h")" || return 1
  [ -f "$anim_cache" ] && { printf '%s\n' "$anim_cache"; return 0; }

  orient="$(media_orientation "$preview_file")"
  [ -n "$orient" ] || orient="landscape"

  if [ "$orient" = "portrait" ]; then
    vf_scale="scale=-2:${pane_h}:flags=lanczos"
  else
    vf_scale="scale=${pane_w}:-2:flags=lanczos"
  fi

  ffmpeg -hide_banner -loglevel error \
    -ss 0 -t 2 -i "$preview_file" \
    -vf "fps=10,${vf_scale},split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" \
    -loop 0 \
    "$anim_cache" || return 1

  printf '%s\n' "$anim_cache"
}

spawn_icat_worker() {
  pane_x="$1"
  pane_y="$2"
  pane_w="$3"
  pane_h="$4"
  tty_path="$5"
  media_file="$6"

  setsid -f "$0" __async_icat "$pane_x" "$pane_y" "$pane_w" "$pane_h" "$tty_path" "$media_file" >/dev/null 2>&1
}

spawn_video_worker() {
  request_id="$1"
  pane_x="$2"
  pane_y="$3"
  pane_w="$4"
  pane_h="$5"
  tty_path="$6"

  setsid -f "$0" __async_video "$request_id" "$pane_x" "$pane_y" "$pane_w" "$pane_h" "$tty_path" "$preview_file" >/dev/null 2>&1
}

play_video() {
  pane_x="$2"
  pane_y="$3"
  pane_w="$4"
  pane_h="$5"
  tty_path="$(find_tty)" || return 1
  request_id="$(cache_base "$preview_file").${pane_w}x${pane_h}.2s"

  preview_allowed || return 1

  if request_is_active "$request_id"; then
    return 0
  fi

  pclear

  case "$preview_file" in
    *.gif|*.GIF|*.webp|*.WEBP)
      set_request "$request_id"
      spawn_icat_worker "$pane_x" "$pane_y" "$pane_w" "$pane_h" "$tty_path" "$preview_file"
      return 0
      ;;
  esac

  anim_file="$(video_preview_file "$pane_w" "$pane_h")"
  if [ -f "$anim_file" ]; then
    set_request "$request_id"
    spawn_icat_worker "$pane_x" "$pane_y" "$pane_w" "$pane_h" "$tty_path" "$anim_file"
    return 0
  fi

  still_file="$(video_still_file)"
  [ -f "$still_file" ] && image "$1" "$pane_x" "$pane_y" "$pane_w" "$pane_h" "$still_file"

  set_request "$request_id"
  spawn_video_worker "$request_id" "$pane_x" "$pane_y" "$pane_w" "$pane_h" "$tty_path"
  return 0
}

video_fallback() {
  still_file="$(video_still_file)" || return 1
  image "$1" "$2" "$3" "$4" "$5" "$still_file"
}

main() {
  case "$1" in
    "__async_icat")
      pane_x="$2"
      pane_y="$3"
      pane_w="$4"
      pane_h="$5"
      tty_path="$6"
      init_preview_context "$7"
      [ -c "$tty_path" ] || exit 1
      [ -x "$KITTY_KITTEN" ] || exit 1
      printf '%s\n' "$$" > "$ICAT_PID_FILE"
      exec "$KITTY_KITTEN" icat \
        --stdin=no \
        --silent \
        --transfer-mode=file \
        --place "${pane_w}x${pane_h}@${pane_x}x${pane_y}" \
        --scale-up \
        --loop -1 \
        "$preview_file" >"$tty_path" <"$tty_path" 2>/dev/null
      ;;
    "__async_video")
      request_id="$2"
      pane_x="$3"
      pane_y="$4"
      pane_w="$5"
      pane_h="$6"
      tty_path="$7"
      init_preview_context "$8"
      printf '%s\n' "$$" > "$WORKER_PID_FILE"
      anim_file="$(render_video_anim "$pane_w" "$pane_h")" || exit 1
      [ "$(current_request)" = "$request_id" ] || exit 0
      clear_display_on_tty "$tty_path"
      rm -f "$WORKER_PID_FILE"
      exec "$0" __async_icat "$pane_x" "$pane_y" "$pane_w" "$pane_h" "$tty_path" "$anim_file"
      ;;
    "clear")
      pclear
      ;;
    "draw")
      init_preview_context "$6"
      preview_allowed || exit 1
      image "$1" "$2" "$3" "$4" "$5" "$preview_file"
      ;;
    "video")
      init_preview_context "$6"
      play_video "$@" || video_fallback "$@"
      ;;
    "epub")
      init_preview_context "$6"
      preview_allowed || exit 1
      [ ! -f "$PCACHE" ] && epub-thumbnailer "$preview_file" "$PCACHE" 1024
      image "$1" "$2" "$3" "$4" "$5" "$PCACHE"
      ;;
    "pdf")
      init_preview_context "$6"
      preview_allowed || exit 1
      [ ! -f "${PCACHE}.jpg" ] && pdftoppm -jpeg -f 1 -singlefile "$preview_file" "$PCACHE"
      image "$1" "$2" "$3" "$4" "$5" "${PCACHE}.jpg"
      ;;
    "djvu")
      init_preview_context "$6"
      preview_allowed || exit 1
      [ ! -f "${PCACHE}.jpg" ] && ddjvu -format=tiff -quality=90 -page=1 "$preview_file" "$PCACHE.jpg"
      image "$1" "$2" "$3" "$4" "$5" "${PCACHE}.jpg"
      ;;
    "audio")
      init_preview_context "$6"
      preview_allowed || exit 1
      [ ! -f "${PCACHE}.jpg" ] && ffmpeg -hide_banner -i "$preview_file" "${PCACHE}.jpg" -y >/dev/null
      image "$1" "$2" "$3" "$4" "$5" "${PCACHE}.jpg"
      ;;
    "font")
      init_preview_context "$6"
      preview_allowed || exit 1
      [ ! -f "${PCACHE}.jpg" ] && fontpreview -i "$preview_file" -o "${PCACHE}.jpg"
      image "$1" "$2" "$3" "$4" "$5" "${PCACHE}.jpg"
      ;;
    *)
      ;;
  esac
}

main "$@"
